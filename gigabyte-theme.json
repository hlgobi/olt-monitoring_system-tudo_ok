{
  "CTkFont": {
    "family": "Calibri",
    "size": 13,
    "weight": "normal",
    "slant": "roman",
    "underline": 0,
    "overstrike": 0
  },
  "CTk": {
    "fg_color": ["#1C003D", "#1C003D"]
  },
  "CTkToplevel": {
    "fg_color": ["#1C003D", "#1C003D"]
  },
  "CTkFrame": {
    "corner_radius": 6,
    "border_width": 1,
    "fg_color": ["#3A1078", "#3A1078"],
    "top_fg_color": ["#1C003D", "#1C003D"],
    "border_color": ["#4E218E", "#4E218E"]
  },
  "CTkButton": {
    "corner_radius": 6,
    "border_width": 0,
    "border_spacing": 2,
    "fg_color": ["#E60965", "#E60965"],
    "hover_color": ["#4E218E", "#4E218E"],
    "border_color": ["#E60965", "#E60965"],
    "text_color": ["#FFFFFF", "#FFFFFF"],
    "text_color_disabled": ["#B0B0B0", "#B0B0B0"]
  },
  "CTkEntry": {
    "corner_radius": 6,
    "border_width": 2,
    "fg_color": ["#4E218E", "#4E218E"],
    "border_color": ["#E60965", "#E60965"],
    "text_color": ["#FFFFFF", "#FFFFFF"],
    "placeholder_text_color": ["#D3D3D3", "#D3D3D3"]
  },
  "CTkLabel": {
    "corner_radius": 0,
    "fg_color": "transparent",
    "text_color": ["#FFFFFF", "#FFFFFF"]
  },
  "CTkCheckBox": {
    "corner_radius": 6,
    "border_width": 2,
    "fg_color": ["#E60965", "#E60965"],
    "hover_color": ["#4E218E", "#4E218E"],
    "text_color": ["#FFFFFF", "#FFFFFF"],
    "border_color": ["#E60965", "#E60965"],
    "checkmark_color": ["#FFFFFF", "#FFFFFF"],
    "text_color_disabled": ["#B0B0B0", "#B0B0B0"]
  },
  "CTkRadioButton":{
    "corner_radius": 10,
    "border_width_checked": 6,
    "border_width_unchecked": 2,
    "fg_color": ["#E60965", "#E60965"],
    "hover_color": ["#4E218E", "#4E218E"],
    "text_color": ["#FFFFFF", "#FFFFFF"],
    "border_color": ["#E60965", "#E60965"],
    "text_color_disabled": ["#B0B0B0", "#B0B0B0"]
  },
  "CTkScrollbar": {
    "corner_radius": 10,
    "border_spacing": 4,
    "fg_color": "transparent",
    "button_color": ["#4E218E", "#4E218E"],
    "button_hover_color": ["#E60965", "#E60965"]
  },
  "CTkSegmentedButton": {
    "corner_radius": 6,
    "border_width": 1,
    "fg_color": ["#3A1078", "#3A1078"],
    "selected_color": ["#E60965", "#E60965"],
    "selected_hover_color": ["#4E218E", "#4E218E"],
    "unselected_color": ["#3A1078", "#3A1078"],
    "unselected_hover_color": ["#4E218E", "#4E218E"],
    "text_color": ["#FFFFFF", "#FFFFFF"],
    "text_color_disabled": ["#B0B0B0", "#B0B0B0"]
  },
  "CTkTabview": {
    "corner_radius": 6,
    "border_width": 1,
    "fg_color": ["#3A1078", "#3A1078"],
    "border_color": ["#4E218E", "#4E218E"]
  },
  "CTkScrollableFrame": {
    "corner_radius": 6,
    "border_width": 1,
    "label_fg_color": ["#3A1078", "#3A1078"],
    "label_text_color": ["#FFFFFF", "#FFFFFF"],
    "border_color": ["#4E218E", "#4E218E"]
  },
"CTkProgressBar": {
      "corner_radius": 1000,
      "border_width": 0,
      "height": 10,
      "fg_color": "#3A1078",
      "progress_color": "#E60965",
      "border_color": "gray"
    },
    "CTkTextbox": {
      "corner_radius": 6,
      "border_width": 1,
      "fg_color": "#1C003D",
      "border_color": "#4E218E",
      "text_color": "#FFFFFF",
      "scrollbar_button_color": "#E60965",
      "scrollbar_button_hover_color": "#4E218E"
    }
  }